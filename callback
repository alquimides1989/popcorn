<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Callback X | Pixel & Popcorn</title>
    <style>
      body {
        max-width: 760px;
        margin: 48px auto;
        padding: 0 20px;
        color: #f7f9ff;
        background: #050912;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      code,
      textarea {
        width: 100%;
        color: #e8f2ff;
        background: #101827;
      }

      textarea {
        min-height: 120px;
        padding: 12px;
        border: 1px solid #2d5b87;
        border-radius: 8px;
      }

      button {
        min-height: 42px;
        padding: 0 18px;
        border: 0;
        border-radius: 8px;
        color: white;
        background: #169cff;
        font-weight: 800;
      }
    </style>
  </head>
  <body>
    <h1>Autorizacion recibida</h1>
    <p>Copia este codigo y pasaselo a Codex para terminar la conexion con X.</p>
    <textarea id="code" readonly></textarea>
    <p><button id="copy" type="button">Copiar codigo</button></p>
    <script>
      const params = new URLSearchParams(location.search);
      const code = params.get("code") || "";
      const error = params.get("error") || "";
      document.getElementById("code").value = error ? `ERROR: ${error}` : code;
      document.getElementById("copy").addEventListener("click", async () => {
        await navigator.clipboard.writeText(document.getElementById("code").value);
      });
    </script>
  </body>
</html>
